/***********************************************************
AM2302    STM32F401
-----    ----------
VDD  →   3.3V
SDA  →   PB5 (with 4.7kΩ pull-up to 3.3V)
NC   →   Not connected
GND  →   GND
***********************************************************/

#include "AM2302.h"

// AM2302 Configuration
#define AM2302_SDA_PIN GPIO_PIN_5
#define AM2302_SDA_PORT GPIOB

// Improved microsecond delay - more precise
void delay_us(uint32_t us) {
    // For 84MHz: Adjust this value based on your clock
    // You may need to calibrate this!
    uint32_t cycles = us * (SystemCoreClock / 1000000) / 5;
    while (cycles--) {
        __NOP();
    }
}

void AM2302_Init(void) {
    // Enable GPIOB clock
    __HAL_RCC_GPIOB_CLK_ENABLE();

    // Initial state: input with external pull-up (4.7kΩ)
    GPIO_InitTypeDef GPIO_InitStruct = {0};
    GPIO_InitStruct.Pin = AM2302_SDA_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
    GPIO_InitStruct.Pull = GPIO_NOPULL;  // External pull-up used
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(AM2302_SDA_PORT, &GPIO_InitStruct);

    // Test the pull-up is working
    char buffer[64];
    if (HAL_GPIO_ReadPin(AM2302_SDA_PORT, AM2302_SDA_PIN) == GPIO_PIN_SET) {
        int len = sprintf(buffer, "AM2302 - Pull-up OK (line HIGH)\r\n");
        Print_Message(buffer, len);
    } else {
        int len = sprintf(buffer, "AM2302 - WARNING: Line is LOW, check wiring\r\n");
        Print_Message(buffer, len);
    }

    // Wait for sensor stabilization
    vTaskDelay(pdMS_TO_TICKS(2500));
}

uint8_t AM2302_Start_Debug(void) {
    char buffer[128];
    uint32_t timeout;

    // Set as output low
    GPIO_InitTypeDef GPIO_InitStruct = {0};
    GPIO_InitStruct.Pin = AM2302_SDA_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(AM2302_SDA_PORT, &GPIO_InitStruct);

    // Pull low for start signal (1ms) - increased for reliability
    HAL_GPIO_WritePin(AM2302_SDA_PORT, AM2302_SDA_PIN, GPIO_PIN_RESET);
    delay_us(1200);  // Increased to 1.2ms

    // Release bus (set as input with pull-up)
    GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
    GPIO_InitStruct.Pull = GPIO_NOPULL;  // External pull-up
    HAL_GPIO_Init(AM2302_SDA_PORT, &GPIO_InitStruct);

    // Wait for sensor response low (80us)
    timeout = 500;  // Increased timeout
    while (HAL_GPIO_ReadPin(AM2302_SDA_PORT, AM2302_SDA_PIN) == GPIO_PIN_SET) {
        if (--timeout == 0) {
            int len = sprintf(buffer, "AM2302 - ERROR: No response (never went low)\r\n");
            Print_Message(buffer, len);
            return 0;
        }
        delay_us(1);
    }

    int len = sprintf(buffer, "AM2302 - Response low OK (timeout left: %lu)\r\n", timeout);
    Print_Message(buffer, len);

    // Wait for response high (80us)
    timeout = 500;
    while (HAL_GPIO_ReadPin(AM2302_SDA_PORT, AM2302_SDA_PIN) == GPIO_PIN_RESET) {
        if (--timeout == 0) {
            len = sprintf(buffer, "AM2302 - ERROR: Stuck low (never went high)\r\n");
            Print_Message(buffer, len);
            return 0;
        }
        delay_us(1);
    }

    len = sprintf(buffer, "AM2302 - Response high OK (timeout left: %lu)\r\n", timeout);
    Print_Message(buffer, len);

    return 1;
}

uint8_t AM2302_ReadBit_Debug(void) {
    uint32_t timeout = 200;
    uint32_t start_time, end_time;

    // Wait for line to go low (start of bit)
    while (HAL_GPIO_ReadPin(AM2302_SDA_PORT, AM2302_SDA_PIN) == GPIO_PIN_SET) {
        if (--timeout == 0) return 0xFF;
        delay_us(1);
    }

    // Wait exactly 50us from the start of low
    delay_us(50);

    // Read the value
    if (HAL_GPIO_ReadPin(AM2302_SDA_PORT, AM2302_SDA_PIN) == GPIO_PIN_SET) {
        // It's a '1' - wait remaining time
        delay_us(30);
        return 1;
    } else {
        // It's a '0'
        delay_us(30);
        return 0;
    }
}

uint8_t AM2302_Read_Debug(float *temperature, float *humidity) {
    uint8_t data[5] = {0};
    char buffer[128];

    int len = sprintf(buffer, "=== AM2302 READ START ===\r\n");
    Print_Message(buffer, len);

    if (!AM2302_Start_Debug()) {
        return 0;
    }

    // Read 40 bits (5 bytes)
    for (int i = 0; i < 5; i++) {
        data[i] = 0;
        for (int j = 0; j < 8; j++) {
            uint8_t bit = AM2302_ReadBit_Debug();
            if (bit == 0xFF) {
                len = sprintf(buffer, "AM2302 - BIT TIMEOUT at byte %d bit %d\r\n", i, j);
                Print_Message(buffer, len);
                return 0;
            }
            data[i] = (data[i] << 1) | bit;
        }
        len = sprintf(buffer, "AM2302 - Byte[%d] = 0x%02X (%u)\r\n", i, data[i], data[i]);
        Print_Message(buffer, len);
    }

    // Display all raw data
    len = sprintf(buffer, "AM2302 - RAW: %02X %02X %02X %02X %02X\r\n",
                 data[0], data[1], data[2], data[3], data[4]);
    Print_Message(buffer, len);

    // Verify checksum
    uint8_t checksum = data[0] + data[1] + data[2] + data[3];
    len = sprintf(buffer, "AM2302 - Checksum calc: %u, received: %u\r\n", checksum, data[4]);
    Print_Message(buffer, len);

    if (checksum != data[4]) {
        len = sprintf(buffer, "AM2302 - CHECKSUM ERROR!\r\n");
        Print_Message(buffer, len);
        return 0;
    }

    // Convert values
    uint16_t hum_raw = (data[0] << 8) | data[1];
    uint16_t temp_raw = (data[2] << 8) | data[3];

    *humidity = hum_raw / 10.0f;

    if (temp_raw & 0x8000) {
        *temperature = -(float)((temp_raw & 0x7FFF) / 10.0f);
    } else {
        *temperature = temp_raw / 10.0f;
    }

    len = sprintf(buffer, "AM2302 - SUCCESS: Temp=%.1fC, Hum=%.1f%%\r\n", *temperature, *humidity);
    Print_Message(buffer, len);
    len = sprintf(buffer, "=== AM2302 READ END ===\r\n");
    Print_Message(buffer, len);

    return 1;
}
